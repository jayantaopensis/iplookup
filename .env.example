# Copy to .env and fill in. Free account: https://www.maxmind.com/en/geolite2/signup
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# Optional
# RATE_LIMIT=0              # requests per minute per IP, 0 = unlimited
# TRUST_PROXY=1             # set when nginx/Caddy/Traefik is in front
# REFRESH_DB_ON_START=true  # re-download GeoLite2 on next restart
